rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Autoriser lecture publique pour les images du portfolio
    match /portfolio/{allPaths=**} {
      allow read, write: if true; // Temporaire - sécuriser avec auth en prod
    }

    match /{allPaths=**} {
      allow read, write: if true; // Temporaire - sécuriser en prod
    }
  }
}
