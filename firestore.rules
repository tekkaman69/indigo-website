rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper : admin authentifié (UIDs alignés avec src/lib/admin.ts) ──
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['ugQ2cJ4Y23fEwHFe4XrFeX3xcbO2'];
    }

    // Portfolio — lecture publique (le filtre "published" est appliqué côté
    // requête), écriture admin uniquement
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assets (bibliothèque d'images de l'éditeur)
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contacts — le formulaire public peut créer, seul l'admin lit/gère
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Témoignages — lecture publique, gestion admin
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Réglages du site — lecture publique, écriture admin
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Formules / offres affichées — lecture publique, écriture admin
    match /formulas/{formulaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mosaïque de la home — lecture publique, sélection gérée par l'admin
    match /mosaic_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Intentions de commande (acomptes packs)
    // - création publique UNIQUEMENT en statut 'pending' (formulaire checkout,
    //   fallback si le SDK admin n'est pas configuré côté serveur)
    // - le passage à 'paid'/'failed' se fait via le webhook Stripe
    //   (SDK admin serveur, contourne les règles) ou via l'admin authentifié
    match /order_intentions/{intentionId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Tout le reste (anciennes collections marketplace : orders,
    // order_messages, order_files, services) : accès refusé par défaut.
  }
}
